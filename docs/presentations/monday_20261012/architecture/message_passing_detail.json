  {
    "kind": "text",
    "x": 7.279999999999999,
    "y": 5.08,
    "text": "Two layers = two spatial hops",
    "size": 15,
    "color": "#123147",
    "bold": true
  },
  {
    "kind": "text",
    "x": 7.279999999999999,
    "y": 5.58,
    "text": "Layer 1 uses adjacent-tile features.\nLayer 2 can carry features from two hops away.\nThese are spatial exchanges, not forecast steps.\nAll nodes still share the same origin and lead.",
    "size": 13,
    "color": "#243C4B",
    "bold": false
  },
  {
    "kind": "box",
    "x": 13.6,
