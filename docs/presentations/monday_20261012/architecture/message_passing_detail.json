    "edge": "#86BEBC"
  },
  {
    "kind": "text",
    "x": 5.47,
    "y": 2.21,
    "text": "2  Aggregate at destination",
    "size": 15,
    "color": "#007F83",
    "bold": true
  },
  {
    "kind": "text",
    "x": 5.47,
    "y": 2.71,
    "text": "m\u0304\u1d62 = mean of incoming messages\nAverage over the tile\u2019s neighbors.\nDegree can vary between tiles.",
    "size": 13,
    "color": "#243C4B",
    "bold": false
  },
